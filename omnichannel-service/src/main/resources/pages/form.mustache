<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="robots" content="noindex">
<title>{{title}}</title>
<style>{{{css}}}</style>
</head>
<body>
<header class="bar"><span class="avatar"></span><span>{{title}}</span></header>
<main class="canvas">
<form method="post" action="{{action}}" class="bubble form" novalidate>
{{#intro}}<p class="intro">{{intro}}</p>{{/intro}}
{{#fields}}
<label class="field">
<span class="label">{{label}}{{#required}} <b>*</b>{{/required}}</span>
{{#isSelect}}<select name="{{key}}"{{#required}} required{{/required}}><option value="">Choose…</option>{{#options}}<option value="{{value}}"{{#selected}} selected{{/selected}}>{{value}}</option>{{/options}}</select>{{/isSelect}}
{{#isTextarea}}<textarea name="{{key}}" rows="4"{{#required}} required{{/required}}>{{value}}</textarea>{{/isTextarea}}
{{#isInput}}<input type="{{inputType}}" name="{{key}}" value="{{value}}"{{#required}} required{{/required}}{{#step}} step="any"{{/step}}>{{/isInput}}
{{#error}}<span class="error">{{error}}</span>{{/error}}
</label>
{{/fields}}
<button type="submit" class="btn primary">{{submitText}}</button>
</form>
</main>
<script>{{{js}}}</script>
</body>
</html>
